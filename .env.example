# Supabase Dashboard > Project Settings > API Keys
# Public browser tarafında sadece publishable key kullanılır; gizli anahtarı NEXT_PUBLIC_ değişkenine ASLA yazmayın.
NEXT_PUBLIC_SUPABASE_URL=https://dvkndlaamlwxikhszpqd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_BURAYA_KENDI_ANAHTARINIZ

# YALNIZCA sunucu tarafında kullanılır. Gerçek değeri sadece .env.local içinde tutun.
# Supabase secret key (sb_secret_...) veya service_role key; tarayıcıya / GitHub'a ASLA gönderilmez.
SUPABASE_SECRET_KEY=BURAYA_GIZLI_SUNUCU_ANAHTARI
# Kişisel veri bilgilendirmesi ve spam koruması hazır olana kadar false kalmalı.
ORDER_REQUESTS_ENABLED=false

# Vercel dışında: yalnızca kendi güvenilir proxy'nizin her istekte ÜZERİNE YAZDIĞI,
# tek IP içeren başlığı belirtin. Uygulama doğrudan internetten erişilememeli.
# Vercel'de x-vercel-forwarded-for otomatik kullanılır. Varsayılan: başlıklardan IP'ye güvenilmez.
# ORDER_REQUEST_TRUSTED_IP_HEADER=x-real-ip
